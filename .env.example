# Copy to .env.local and fill in. Real .env files are gitignored; never commit one.

# Where the game server (Nakama) answers HTTP.
YOREHOLD_SERVER=http://127.0.0.1:7350

# The server's HTTP key (HTTP_KEY in yorehold-server/.env). Used for the public RPCs.
YOREHOLD_SERVER_HTTP_KEY=change-me

# The server's client key (SERVER_KEY in yorehold-server/.env). Used only to sign in and sign up.
YOREHOLD_SERVER_KEY=change-me

# Where the game download lives. Shown on /play and as a fallback on content pages.
YOREHOLD_DOWNLOAD_URL=https://github.com/JoshWright22/yorehold/releases
